{
  "version": 6,
  "configurePresets": [
    {
      "name": "win32",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win32",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static-md",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win64",
      "inherits": "win32",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "linux64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/linux64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux32",
      "inherits": "linux64",
      "binaryDir": "${sourceDir}/build/linux32",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32"
      },
      "environment": {
        "PKG_CONFIG_LIBDIR": "/usr/lib/i386-linux-gnu/pkgconfig:/usr/share/pkgconfig"
      }
    },
    {
      "name": "android-arm64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "UT_STATIC_LINK": "ON"
      }
    },
    {
      "name": "ios-arm64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios-arm64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
        "UT_STATIC_LINK": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "web",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
        "CMAKE_C_FLAGS": "-fwasm-exceptions",
        "CMAKE_CXX_FLAGS": "-fwasm-exceptions",
        "CMAKE_EXE_LINKER_FLAGS": "-fwasm-exceptions",
        "UT_STATIC_LINK": "ON"
      }
    },
    {
      "name": "win32-static",
      "inherits": "win32",
      "binaryDir": "${sourceDir}/build/win32-static",
      "cacheVariables": {
        "UT_STATIC_LINK": "ON"
      }
    },
    {
      "name": "win64-static",
      "inherits": "win64",
      "binaryDir": "${sourceDir}/build/win64-static",
      "cacheVariables": {
        "UT_STATIC_LINK": "ON"
      }
    },
    {
      "name": "linux64-static",
      "inherits": "linux64",
      "binaryDir": "${sourceDir}/build/linux64-static",
      "cacheVariables": {
        "UT_STATIC_LINK": "ON"
      }
    },
    {
      "name": "linux32-static",
      "inherits": "linux32",
      "binaryDir": "${sourceDir}/build/linux32-static",
      "cacheVariables": {
        "UT_STATIC_LINK": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-debug",
      "configurePreset": "win32",
      "configuration": "Debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32",
      "configuration": "Release"
    },
    {
      "name": "win64-debug",
      "configurePreset": "win64",
      "configuration": "Debug"
    },
    {
      "name": "win64-release",
      "configurePreset": "win64",
      "configuration": "Release"
    },
    {
      "name": "linux64-debug",
      "configurePreset": "linux64",
      "configuration": "Debug"
    },
    {
      "name": "linux64-release",
      "configurePreset": "linux64",
      "configuration": "Release"
    },
    {
      "name": "linux32-debug",
      "configurePreset": "linux32",
      "configuration": "Debug"
    },
    {
      "name": "linux32-release",
      "configurePreset": "linux32",
      "configuration": "Release"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64",
      "targets": ["ut_apk"]
    },
    {
      "name": "ios-arm64-release",
      "configurePreset": "ios-arm64",
      "targets": ["ut_ipa"]
    },
    {
      "name": "web-release",
      "configurePreset": "web",
      "targets": ["ut_web"]
    },
    {
      "name": "win32-static-debug",
      "configurePreset": "win32-static",
      "configuration": "Debug"
    },
    {
      "name": "win32-static-release",
      "configurePreset": "win32-static",
      "configuration": "Release"
    },
    {
      "name": "win64-static-debug",
      "configurePreset": "win64-static",
      "configuration": "Debug"
    },
    {
      "name": "win64-static-release",
      "configurePreset": "win64-static",
      "configuration": "Release"
    },
    {
      "name": "linux64-static-debug",
      "configurePreset": "linux64-static",
      "configuration": "Debug"
    },
    {
      "name": "linux64-static-release",
      "configurePreset": "linux64-static",
      "configuration": "Release"
    },
    {
      "name": "linux32-static-debug",
      "configurePreset": "linux32-static",
      "configuration": "Debug"
    },
    {
      "name": "linux32-static-release",
      "configurePreset": "linux32-static",
      "configuration": "Release"
    }
  ]
}
